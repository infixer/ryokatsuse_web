{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infixer-net",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "DISCOVERY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  // infixer.net を Custom Domain として接続（DNS レコードと証明書は Cloudflare が自動管理）
  "routes": [
    {
      "pattern": "infixer.net",
      "custom_domain": true
    }
  ],
  // Astro の session ストア。デプロイ時に Wrangler が自動でプロビジョニングする
  "kv_namespaces": [
    {
      "binding": "SESSION"
    }
  ]
}
