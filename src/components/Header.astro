---
import { SITE_TITLE } from '../config';
import SearchModal from './SearchModal.astro';
---

<header id="site-header" class="header-container bg-neutral-800 fixed top-0 left-0 right-0 transition-transform duration-300">
  <div class="flex items-center justify-between w-full py-4 px-4 sm:px-6 lg:px-8">
    <a
      class="flex items-center gap-x-2 w-fit text-white"
      href={Astro.url.pathname !== '/' ? '/' : null}
      rel="prefetch"
    >
      <img class="w-7 rounded-full bg-white" src="/images/ryokatsu.jpg" width="48" height="48" alt="" decoding="async" />
      {SITE_TITLE}
    </a>
    <div class="flex gap-x-4 items-center">
      <button
        id="search-toggle"
        class="text-white hover:text-gray-300 flex items-center cursor-pointer"
        aria-label="検索を開く"
        aria-expanded="false"
        aria-controls="search-modal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <ul class="flex gap-x-4 items-center">
        <li>
          <a class="text-white hover:text-gray-300 flex items-center" href="/posts-feed.xml" title="RSS Feed">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-rss" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          </a>
        </li>
        <li>
          <!-- テーマ切り替え（3状態）: どちらも未選択 = システム設定に従う -->
          <div
            id="theme-switch"
            class="flex items-center gap-x-0.5 rounded-full bg-white/10 p-0.5"
            role="group"
            aria-label="テーマ設定"
          >
            <button
              type="button"
              data-theme-value="light"
              class="flex items-center justify-center rounded-full p-1.5 text-gray-300 cursor-pointer transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white aria-pressed:bg-white aria-pressed:text-neutral-900"
              aria-pressed="false"
              aria-label="ライトモードに固定する"
              title="ライトモードに固定する"
            >
              <!-- 太陽アイコン -->
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
            </button>
            <button
              type="button"
              data-theme-value="dark"
              class="flex items-center justify-center rounded-full p-1.5 text-gray-300 cursor-pointer transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white aria-pressed:bg-white aria-pressed:text-neutral-900"
              aria-pressed="false"
              aria-label="ダークモードに固定する"
              title="ダークモードに固定する"
            >
              <!-- 月アイコン -->
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
          <p id="theme-status" class="sr-only" role="status" aria-live="polite"></p>
        </li>
      </ul>
    </div>
  </div>
</header>

<SearchModal />

<script>
  // テーマ切り替え（3状態: light / dark / システム設定）
  // localStorage の 'theme' が 'light' | 'dark' ならその値に固定し、未設定ならOSの設定に従う。
  // 選択中のボタンをもう一度押すと保存値を削除して、システム設定へ戻せる。
  type ThemeChoice = 'light' | 'dark' | null;

  const themeSwitch = document.getElementById('theme-switch') as HTMLElement;
  const themeStatus = document.getElementById('theme-status') as HTMLElement;
  const themeButtons = Array.from(themeSwitch.querySelectorAll<HTMLButtonElement>('[data-theme-value]'));
  const darkMedia = window.matchMedia('(prefers-color-scheme: dark)');

  const themeLabels = { light: 'ライト', dark: 'ダーク' } as const;

  const getThemeChoice = (): ThemeChoice => {
    const stored = localStorage.getItem('theme');
    return stored === 'light' || stored === 'dark' ? stored : null;
  };

  const renderThemeSwitch = (choice: ThemeChoice) => {
    for (const button of themeButtons) {
      const value = button.dataset.themeValue as 'light' | 'dark';
      const pressed = value === choice;
      const label = `${themeLabels[value]}モード`;
      const description = pressed
        ? `${label}に固定中。もう一度押すとシステム設定に戻ります`
        : `${label}に固定する`;

      button.setAttribute('aria-pressed', String(pressed));
      button.setAttribute('aria-label', description);
      button.title = description;
    }

    themeStatus.textContent =
      choice === null
        ? `システム設定に従っています（現在: ${themeLabels[darkMedia.matches ? 'dark' : 'light']}モード）`
        : `${themeLabels[choice]}モードに固定中です`;
  };

  const applyTheme = (choice: ThemeChoice) => {
    const isDark = choice === null ? darkMedia.matches : choice === 'dark';
    document.documentElement.classList.toggle('dark', isDark);
    renderThemeSwitch(choice);
  };

  // 初期表示（html.dark 自体は Layout.astro のインラインスクリプトが設定済み）
  renderThemeSwitch(getThemeChoice());

  themeSwitch.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-value]');
    if (!button) return;

    const value = button.dataset.themeValue as 'light' | 'dark';
    // 選択中のものを再度押した場合はシステム設定へ戻す
    const next: ThemeChoice = getThemeChoice() === value ? null : value;

    if (next === null) {
      localStorage.removeItem('theme');
    } else {
      localStorage.setItem('theme', next);
    }

    applyTheme(next);
  });

  // システム設定に従っている間はOSのテーマ変更に追従する
  darkMedia.addEventListener('change', () => {
    if (getThemeChoice() === null) applyTheme(null);
  });

  // ヘッダーのスクロール制御
  const header = document.getElementById('site-header') as HTMLElement;
  const scrollState = { lastScrollY: window.scrollY, ticking: false };

  const updateHeader = (state: typeof scrollState) => () => {
    const currentScrollY = window.scrollY;

    if (currentScrollY <= 0) {
      // ページ最上部では常に表示
      header.style.transform = 'translateY(0)';
    } else if (currentScrollY > state.lastScrollY) {
      // 下にスクロール時は隠す
      header.style.transform = 'translateY(-100%)';
    } else {
      // 上にスクロール時は表示
      header.style.transform = 'translateY(0)';
    }

    state.lastScrollY = currentScrollY;
    state.ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (!scrollState.ticking) {
      window.requestAnimationFrame(updateHeader(scrollState));
      scrollState.ticking = true;
    }
  });

  // 検索モーダルのトリガー（モーダル本体は SearchModal.astro が管理）
  const searchToggle = document.getElementById('search-toggle') as HTMLButtonElement;

  searchToggle.addEventListener('click', () => {
    searchToggle.setAttribute('aria-expanded', 'true');
    document.dispatchEvent(new CustomEvent('search:open'));
  });

  document.addEventListener('search:closed', () => {
    searchToggle.setAttribute('aria-expanded', 'false');
    searchToggle.focus();
  });
</script>

<style>
  .header-container {
    z-index: var(--z-header);
    isolation: isolate;
  }
</style>
