---
import { type CollectionEntry, getCollection } from 'astro:content';
import ContentDiscovery from '../components/ContentDiscovery.astro';
import Layout from '../components/Layout.astro';
import Materials from '../components/Materials.astro';
import PoemList from '../components/PoemList.astro';
import PostList from '../components/PostList.astro';
import {
  epochMilliseconds,
  formatLongDate,
  toISOString,
} from '../lib/datetime';

const allBlogEntries = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    epochMilliseconds(b.data.publishDate) -
    epochMilliseconds(a.data.publishDate),
);

const latestPoems = (await getCollection('poems'))
  .sort(
    (a: CollectionEntry<'poems'>, b: CollectionEntry<'poems'>) =>
      epochMilliseconds(b.data.publishDate) -
      epochMilliseconds(a.data.publishDate),
  )
  .slice(0, 3)
  .map((poem: CollectionEntry<'poems'>) => ({
    title: poem.data.title,
    slug: poem.id,
    date: formatLongDate(poem.data.publishDate),
    datetime: toISOString(poem.data.publishDate),
  }));

const description = 'JavaScriptエンジニア。インターフェースデザインが好き。';

// OGP取得を含むページなのでCDNキャッシュを効かせる
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=600, stale-while-revalidate=86400',
);

// Astroコンテンツコレクションの型に対応
type BlogEntry = {
  title: string;
  slug: string;
  date: string;
  datetime: string;
  description?: string;
};

const blogEntries: BlogEntry[] = allBlogEntries.map(
  (post: CollectionEntry<'blog'>) => {
    const parts = post.id.split('/');
    const slug =
      parts.length >= 2
        ? `${parts[parts.length - 2]}/${parts[parts.length - 1].replace(/\.(md|mdx)$/, '')}`
        : '';

    let description = '';
    if (post.body) {
      const cleanText = post.body
        .replace(/^import.*?;$/gm, '')
        .replace(/!\[.*?\]\(.*?\)/g, '')
        .replace(/<LinkCard.*?\/>/g, '')
        .replace(/<.*?>/g, '')
        .replace(/```[\s\S]*?```/g, '')
        .replace(/#+\s+.*?\n/g, '')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/\n\s*\n/g, '\n')
        .trim();

      // 100文字以内に切り詰め
      description =
        cleanText.length > 100
          ? cleanText.substring(0, 100) + '...'
          : cleanText;
    }

    return {
      title: post.data.title,
      slug,
      date: formatLongDate(post.data.publishDate),
      datetime: toISOString(post.data.publishDate),
      description,
    };
  },
);
---

<Layout description={description} wide>
  <h1 class="sr-only">infixer.net — JavaScript エンジニアのブログ</h1>
  <section class="mb-12 text-lg">
    <p>都内でソフトウェアエンジニアをしています。技術系はフロントエンドネタの記事が多めです。その他に雑多な学びや思考を書いています。</p>
    <p class="mt-4">
      <a
        class="about-link group inline-flex items-center gap-2 rounded-full border border-gray-300 px-4 py-2 text-base font-bold text-gray-900! no-underline transition hover:border-gray-900 hover:bg-gray-900 hover:text-white! focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-neutral-600 dark:text-gray-50! dark:hover:border-white dark:hover:bg-white dark:hover:text-neutral-900!"
        href="/about"
        rel="prefetch"
      >
        About
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </a>
    </p>
  </section>
  <ContentDiscovery />
  <h2 class="text-2xl font-bold mb-8">最近の投稿記事</h2>
  <section class="mb-8">
    <PostList items={blogEntries.slice(0, 4)} />
  </section>
  <div><a class="text-black dark:text-white underline hover:hover:no-underline" href="/blog">すべての記事一覧</a></div>

  <h2 class="text-2xl font-bold mb-4 mt-12">最新のポエム</h2>
  <p class="mb-8">うまく説明できないことを、ポエムのかたちで書いています。本文は縦書きです。</p>
  <section class="mb-8">
    <PoemList items={latestPoems} />
  </section>
  <div><a class="text-black dark:text-white underline hover:hover:no-underline" href="/poems" rel="prefetch">すべてのポエム</a></div>
  <h2 id="materials" class="text-2xl font-bold mb-4 mt-12 scroll-mt-20">登壇資料・作ったもの</h2>
  <p class="mb-8">これまでの登壇資料と、個人で作ったものをまとめています。</p>
  <section class="mb-12">
    <Materials />
  </section>
</Layout>
