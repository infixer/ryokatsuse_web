---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { Image } from 'astro:assets';
import TableOfContents from '../../components/TableOfContents.astro';
import LikeButton from '../../components/LikeButton.astro';
import References from '../../components/References.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// <Cite> が番号を引けるよう、本文を描画する前に参照一覧を渡しておく
Astro.locals.references = entry.data.references ?? [];
Astro.locals.citeCounts = {};
const citedIds = new Set(
  [...(entry.body ?? '').matchAll(/<Cite\s+id=["']([^"']+)["']/g)].map((m) => m[1]),
);
const { Content, headings } = await render(entry);

const assetModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/**/*',
  { eager: true },
);
const assets = Object.values(assetModules);
const ogImageURLAsset = assets.find((asset) => {
  if (!entry.data.ogImageURL) {
    return false;
  }
  if (!asset.default?.src) {
    return false;
  }
  const index = asset.default.src.indexOf('/assets/');
  return asset.default.src.slice(index) === entry.data.ogImageURL;
});
---

<Layout
  title={entry.data.title}
  description={entry.data.description || ""}
  ogType="article"
  image={entry.data.ogImageURL || `/og/${entry.id.replace(/\//g, '-')}.png`}
  twitterCard={entry.data.twitterCard as "summary" | "summary_large_image" | undefined}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <article>
    <div class="mb-8">
      <a href="/blog" class="text-black dark:text-white underline hover:hover:no-underline flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        記事一覧に戻る
      </a>
    </div>
    {ogImageURLAsset && <div class="flex justify-center items-center"><Image class="mb-4 rounded-md" src={ogImageURLAsset.default} alt="" /></div>}
    <h1 class="text-2xl font-bold">{entry.data.title}</h1>
    
    <div class="flex items-center justify-between my-2">
      <div>
        {entry.data.publishDate && <time>{entry.data.publishDate}</time>}
        {
          entry.data.updatedDate && (
            <span class="ml-4">
              更新日 <time>{entry.data.updatedDate}</time>
            </span>
          )
        }
      </div>
      
      <div class="flex items-center gap-2">
        <LikeButton slug={entry.id} />

        <favorite-button data-slug={entry.id}>
          <button
            type="button"
            class="p-2 rounded-full transition-colors hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
            aria-label="お気に入りに追加"
            aria-pressed="false"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-gray-500 dark:text-gray-400 favorite-icon"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              fill="none"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
              />
            </svg>
          </button>
        </favorite-button>
      </div>
    </div>
    
    <hr class="my-4" />
    <TableOfContents headings={headings.filter((heading: {depth: number}) => heading.depth >= 2 && heading.depth <= 4)} />
    <div class="container post">
      <Content />
    </div>
    <References references={entry.data.references} citedIds={citedIds} />
    <ShareButtons title={entry.data.title} url={new URL(Astro.url.pathname, Astro.site).toString()} />
  </article>
</Layout>

<script>
  import { registerCodeCopy } from '../../components/CodeCopy';
  import { registerFavoriteButton } from '../../components/FavoriteButton';
  registerCodeCopy();
  registerFavoriteButton();

  // ヘッダーの表示/非表示に合わせてプログレスバーの位置を調整
  const progressBar = document.querySelector('.reading-progress') as HTMLElement;
  const header = document.getElementById('site-header') as HTMLElement;

  if (progressBar && header) {
    const observer = new MutationObserver(() => {
      const headerTransform = header.style.transform;
      if (headerTransform === 'translateY(-100%)') {
        progressBar.style.top = '0';
      } else {
        progressBar.style.top = '53px';
      }
    });

    observer.observe(header, {
      attributes: true,
      attributeFilter: ['style']
    });
  }
</script>

<style is:global>
  @keyframes progress-grow {
    to {
      transform: scaleX(1);
    }
  }

  .reading-progress {
    position: fixed;
    top: 53px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(to right, var(--color-blue-500), var(--color-violet-500));
    transform-origin: left center;
    transform: scaleX(0);
    z-index: var(--z-reading-progress);
    isolation: isolate;
    pointer-events: none;
    transition: top 0.3s ease;
    animation: progress-grow linear both;
    animation-timeline: scroll();
  }

  .dark .reading-progress {
    background: linear-gradient(to right, var(--color-blue-400), var(--color-violet-400));
  }
</style>
