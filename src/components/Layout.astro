---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../config';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  /** コンテンツ幅を少し広げる（トップページ用） */
  wide?: boolean;
}

const siteTitle = SITE_TITLE;

const {
  title = siteTitle,
  description,
  ogType = 'website',
  image,
  twitterCard = 'summary_large_image',
  wide = false,
} = Astro.props as Props;
let canonicalURL: URL = new URL(Astro.url.pathname, Astro.site);

// Prism型定義
declare global {
  interface Window {
    Prism: any;
  }
}
---

<html lang="ja">
  <head>
    <!-- ダークモード初期化（FOUC防止のため最初に実行） -->
    <!-- theme は 'light' | 'dark' | 未設定（= システム設定に従う）の3状態 -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        const isDark = theme === 'light' || theme === 'dark'
          ? theme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (isDark) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- メインCSS読み込み前のちらつき防止 -->
    <style is:inline>
      /* ライト固定時はOSがダークでもフォームやスクロールバーが暗くならないよう明示する */
      html:not(.dark) { color-scheme: light; }
      html.dark { color-scheme: dark; background-color: oklch(26.9% 0 0); }
      html.dark body { background-color: oklch(26.9% 0 0); color: oklch(98.5% 0.002 247.839); }
      a { color: inherit; }
      html.dark a { color: oklch(98.5% 0.002 247.839); }
      /* ヘッダーは両モード共通で暗背景・白文字。Tailwind ロード前のちらつき/不可視を防止 */
      #site-header { background-color: oklch(26.9% 0 0); color: oklch(100% 0 0); }
      #site-header a { color: oklch(100% 0 0); }
    </style>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" href="/posts-feed.xml" type="application/rss+xml" />
    <Font cssVariable='--font-noto-sans-jp' preload />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    {description && <meta name="description" content={description} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {image && <meta property="og:image" content={new URL(image, Astro.url)} />}
    <!-- Twitter -->
    <meta name="twitter:site" content="@ryo__kts" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={new URL(image, Astro.url)} />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <!-- PrismJSのスタイルとスクリプト -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-typescript.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-bash.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-javascript.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-jsx.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-tsx.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-json.min.js" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-css.min.js" is:inline></script>
    <script is:inline>
      // ページロード後にシンタックスハイライトを実行
      document.addEventListener('DOMContentLoaded', () => {
        if (typeof window.Prism !== 'undefined') {
          window.Prism.highlightAll();
        }
      });
    </script>
  </head>
  <body class="dark:bg-neutral-800 dark:text-gray-50 font-noto-sans pt-14">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-black focus:px-3 focus:py-2 focus:outline-2 focus:outline-blue-500 dark:focus:bg-neutral-900 dark:focus:text-white">本文へスキップ</a>
    <Header title={SITE_TITLE} />
    <main id="main-content" tabindex="-1" class="dark:bg-neutral-800">
      <div class={`${wide ? 'max-w-5xl' : 'max-w-3xl'} mx-auto p-4`}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
