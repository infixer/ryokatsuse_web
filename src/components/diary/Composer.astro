---
import type { DiaryPost } from '../../lib/diary/db';
import { MAX_IMAGES } from '../../lib/diary/input';
import type { OgpData } from '../../lib/ogp';
import ComposerLink from './ComposerLink.astro';

export interface Props {
  /** 編集するときの投稿。無ければ新規投稿 */
  post?: DiaryPost;
  previews?: Map<string, OgpData>;
}

const { post, previews = new Map() } = Astro.props;
const mode = post ? 'edit' : 'new';
---

<form
  id="diary-composer"
  class="rounded-xl border border-gray-200 bg-white dark:border-neutral-700 dark:bg-neutral-900"
  data-mode={mode}
  data-post-id={post?.id}
  data-max-images={MAX_IMAGES}
  data-initial-images={JSON.stringify(post?.images ?? [])}
  novalidate
>
  <div class="flex gap-3 p-4 pb-2">
    <img class="h-10 w-10 shrink-0 rounded-full bg-white" src="/images/ryokatsu.jpg" width="48" height="48" alt="" />
    <div class="min-w-0 flex-1">
      <label for="composer-body" class="sr-only">本文</label>
      <textarea
        id="composer-body"
        name="body"
        rows="4"
        placeholder="今日のこと"
        class="composer-body block w-full resize-none border-0 bg-transparent p-0 pt-1.5 text-lg leading-8 tracking-[0.02em] placeholder:text-gray-400 focus:outline-none focus:ring-0 dark:placeholder:text-neutral-500"
      >{post?.body ?? ''}</textarea>

      <div id="composer-images" class="mt-3 grid grid-cols-2 gap-2 empty:hidden"></div>

      <div id="composer-links">
        {post?.links.map((url) => <ComposerLink url={url} ogp={previews.get(url)} />)}
      </div>

      <p id="composer-status" class="mt-2 min-h-5 text-sm text-gray-500 dark:text-neutral-400" role="status" aria-live="polite"></p>
    </div>
  </div>

  <!-- スマホでは本文が長くなってもキーボードのすぐ上に残るよう sticky にする -->
  <div class="sticky bottom-0 flex items-center justify-between gap-3 rounded-b-xl border-t border-gray-200 bg-white/95 px-4 py-2 backdrop-blur dark:border-neutral-700 dark:bg-neutral-900/95">
    <div class="flex items-center gap-1">
      <button
        type="button"
        id="composer-add-image"
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-blue-600 hover:bg-blue-50 disabled:cursor-not-allowed disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-blue-600 dark:text-blue-400 dark:hover:bg-blue-950"
        aria-label="画像を追加"
        title="画像を追加"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <path d="M21 15l-5-5L5 21" />
        </svg>
      </button>
      <input type="file" id="composer-file" accept="image/*" multiple hidden />
      <span class="hidden text-xs text-gray-500 sm:inline dark:text-neutral-400">URL を貼るとリンクカードになります</span>
    </div>
    <div class="flex items-center gap-3">
      <span class="hidden text-xs text-gray-500 md:inline dark:text-neutral-400">⌘ / Ctrl + Enter</span>
      <button
        type="submit"
        id="composer-submit"
        class="cursor-pointer rounded-full bg-neutral-900 px-5 py-2 font-bold text-white transition hover:bg-neutral-700 disabled:cursor-not-allowed disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
        disabled
      >
        {post ? '更新する' : '投稿する'}
      </button>
    </div>
  </div>
</form>

<style>
  .composer-body {
    /* 入力量に合わせて高さを伸ばす（未対応ブラウザはスクリプトで調整） */
    field-sizing: content;
    min-height: 8rem;
  }
</style>

<script>
  import { initComposer } from './composer';

  const form = document.getElementById('diary-composer');
  if (form instanceof HTMLFormElement) initComposer(form);
</script>
