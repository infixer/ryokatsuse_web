{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infixer-net",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // infixer.net を Custom Domain として接続（DNS レコードと証明書は Cloudflare が自動管理）
  "routes": [
    {
      "pattern": "infixer.net",
      "custom_domain": true
    }
  ],
  // Astro の session ストア。デプロイ時に Wrangler が自動でプロビジョニングする
  "kv_namespaces": [
    {
      "binding": "SESSION"
    }
  ],
  // 日記の本文・リンクカードのキャッシュ。初回デプロイ時に Wrangler が自動で作成する
  // テーブルは db/diary-migrations の SQL で作る（docs/diary.md 参照）
  "d1_databases": [
    {
      "binding": "DIARY_DB",
      "database_name": "infixer-diary",
      "migrations_dir": "db/diary-migrations"
    }
  ],
  // 日記に添付した画像。/media/* から配信する
  "r2_buckets": [
    {
      "binding": "DIARY_MEDIA",
      "bucket_name": "infixer-diary-media"
    }
  ]
}
