---
export const prerender = true;

import Layout from '../components/Layout.astro';
import Materials from '../components/Materials.astro';

const description = 'これまでの登壇資料と、個人で作ったもののリンク集です。';

---

<Layout title="登壇資料・作ったもの" description={description} wide>
  <h1 class="text-2xl font-bold mb-4">登壇資料・作ったもの</h1>
  <p class="mb-8">これまでの登壇資料と、個人で作ったものをまとめています。詳しくは<a class="text-black dark:text-white underline hover:hover:no-underline" href="https://scrapbox.io/ryokatsu/%E6%88%90%E6%9E%9C%E7%89%A9">成果物</a>にも書いています。</p>
  <section class="mb-12">
    <Materials />
  </section>
</Layout>
