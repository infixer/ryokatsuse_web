{
  "name": "ryokatsu.dev",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "og": "tsx scripts/generate-og.mts",
    "build": "pnpm og && astro build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "test:images": "tsx --test tests/responsive-markdown-images.test.ts",
    "infixer": "infixer",
    "test:cli": "pnpm --filter @infixer/cli test",
    "typecheck:packages": "tsc -p packages/core && tsc -p packages/cli"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.6",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@infixer/core": "workspace:*",
    "@libsql/client": "^0.17.0",
    "@resvg/resvg-js": "^2.4.1",
    "astro": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "postcss": ">=8.4.29 <9.0.0",
    "prismjs": "^1.30.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "satori": "^0.10.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.3.14",
    "@infixer/cli": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "mdast-util-to-hast": "^13.2.0",
    "playwright": "^1.52.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "wrangler": "^4.115.0"
  }
}
