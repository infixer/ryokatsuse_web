---
import Layout from '../../components/Layout.astro';
import DiaryPost from '../../components/diary/DiaryPost.astro';
import FeedRssLink from '../../components/diary/FeedRssLink.astro';
import { getLinkPreviews, listPosts } from '../../lib/diary/db';

// 投稿してすぐ反映させるため、リクエストごとに描画する
const before = Astro.url.searchParams.get('before');
const { posts, nextCursor } = await listPosts({ before });
const previews = await getLinkPreviews(posts.flatMap((post) => post.links));

const description = '日々のことを短く書いているフィードです。';
---

<Layout title="フィード" description={description}>
  <link slot="head" rel="alternate" href="/feed/rss.xml" type="application/rss+xml" title="infixer.net フィード" />
  <div class="mb-2 flex items-center gap-2">
    <h1 class="text-2xl font-bold">フィード</h1>
    <FeedRssLink />
  </div>
  <p class="mb-4 text-gray-600 dark:text-neutral-300">{description}</p>

  {posts.length === 0 ? (
    <p class="py-10 text-center text-gray-500 dark:text-neutral-400">
      {before ? 'これより前の投稿はありません。' : 'まだ投稿はありません。'}
    </p>
  ) : (
    <div class="border-t border-gray-200 dark:border-neutral-700">
      {posts.map((post) => <DiaryPost post={post} previews={previews} />)}
    </div>
  )}

  <nav class="mt-8 flex justify-between gap-4" aria-label="フィードのページ送り">
    {before ? (
      <a class="text-black dark:text-white underline hover:no-underline" href="/feed">最新の投稿へ</a>
    ) : <span />}
    {nextCursor && (
      <a
        class="text-black dark:text-white underline hover:no-underline"
        href={`/feed?before=${encodeURIComponent(nextCursor)}`}
      >
        もっと前の投稿
      </a>
    )}
  </nav>
</Layout>
