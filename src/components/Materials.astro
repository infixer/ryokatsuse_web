---
import { loadTalks, loadWorks } from '../lib/api-v1';
import { fetchOgpAll } from '../lib/ogp';
import OgpCard from './OgpCard.astro';

const [talks, works] = await Promise.all([loadTalks(), loadWorks()]);

// 新しいものが上に来るように並べ替える（データは時系列順）
const sortedTalks = [...talks].sort((a, b) => b.date.localeCompare(a.date));

// このコンポーネントを使う公開ページは静的生成し、OGP取得をビルド時に完了させる
const [talkCards, workCards] = await Promise.all([
  fetchOgpAll(sortedTalks),
  fetchOgpAll(works),
]);

const tabs = [
  { id: 'talks', label: '登壇資料', count: talkCards.length },
  { id: 'works', label: '作ったもの', count: workCards.length },
];
---

<div class="materials" data-materials>
  <div class="-mx-4 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0">
    <div
      role="tablist"
      aria-label="登壇資料と作ったもの"
      class="inline-flex min-w-full gap-1 rounded-lg bg-gray-100 p-1 sm:min-w-0 dark:bg-neutral-700"
    >
      {tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="flex-1 cursor-pointer whitespace-nowrap rounded-md px-4 py-2 text-sm font-bold text-gray-600 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 aria-selected:bg-white aria-selected:text-gray-900 aria-selected:shadow-sm dark:text-neutral-300 dark:aria-selected:bg-neutral-900 dark:aria-selected:text-white"
        >
          {tab.label}
          <span class="ml-1 text-xs font-normal">({tab.count})</span>
        </button>
      ))}
    </div>
  </div>

  <div
    role="tabpanel"
    id="panel-talks"
    aria-labelledby="tab-talks"
    tabindex="0"
    class="mt-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
  >
    <ul class="grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {talkCards.map(talk => (
        <li class="min-w-0">
          <OgpCard
            url={talk.url}
            ogp={talk.ogp}
            badge={talk.scope === 'internal' ? '社内' : '社外'}
            note={talk.event}
            date={talk.date}
          />
        </li>
      ))}
    </ul>
  </div>

  <div
    role="tabpanel"
    id="panel-works"
    aria-labelledby="tab-works"
    tabindex="0"
    hidden
    class="mt-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600"
  >
    <ul class="grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {workCards.map(work => (
        <li class="min-w-0">
          <OgpCard url={work.url} ogp={work.ogp} description={work.description} />
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-materials]').forEach(root => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    if (tabs.length === 0) return;

    const selectTab = (nextTab: HTMLButtonElement, focus = true) => {
      tabs.forEach(tab => {
        const isSelected = tab === nextTab;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;

        const panel = document.getElementById(
          tab.getAttribute('aria-controls') ?? '',
        );
        if (panel) panel.hidden = !isSelected;
      });
      if (focus) nextTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab, false));
      tab.addEventListener('keydown', event => {
        const keyMap: Record<string, number> = {
          ArrowRight: index + 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        const nextIndex = keyMap[event.key];
        if (nextIndex === undefined) return;
        event.preventDefault();
        selectTab(tabs[(nextIndex + tabs.length) % tabs.length]);
      });
    });
  });
</script>
