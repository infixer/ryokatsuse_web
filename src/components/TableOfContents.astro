---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

const indentClass = (depth: number) =>
  depth === 2 ? 'pl-3' : depth === 3 ? 'pl-6' : 'pl-9';
---

{headings.length > 0 && (
  <>
    {/* PC（xl以上）: 本文の右側にスティッキーで追従 */}
    <aside class="toc-aside hidden xl:block absolute top-0 left-full h-full w-56 ml-12">
      <nav class="sticky top-20 max-h-[calc(100vh-7rem)] overflow-y-auto pb-4" aria-labelledby="toc-title-desktop">
        <h2 id="toc-title-desktop" class="mb-3 text-xs font-bold tracking-widest text-neutral-500 dark:text-neutral-400">
          目次
        </h2>
        <ol class="toc-list border-l border-neutral-200 dark:border-neutral-700">
          {headings.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} class={`toc-link ${indentClass(heading.depth)}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>

    {/* SP・タブレット（xl未満）: 右下のボタンから開くポップオーバー */}
    <div class="toc-mobile xl:hidden">
      <button
        type="button"
        class="toc-fab"
        popovertarget="toc-popover"
        aria-label="目次"
        title="目次"
      >
        <svg class="toc-fab-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="9" y1="6" x2="20" y2="6"></line>
          <line x1="9" y1="12" x2="20" y2="12"></line>
          <line x1="9" y1="18" x2="20" y2="18"></line>
          <circle cx="4.5" cy="6" r="1"></circle>
          <circle cx="4.5" cy="12" r="1"></circle>
          <circle cx="4.5" cy="18" r="1"></circle>
        </svg>
        <svg class="toc-fab-icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <nav id="toc-popover" class="toc-popover" popover aria-labelledby="toc-title-mobile">
        <h2 id="toc-title-mobile" class="mb-3 px-1 text-xs font-bold tracking-widest text-neutral-500 dark:text-neutral-400">
          目次
        </h2>
        <ol class="toc-list border-l border-neutral-200 dark:border-neutral-700">
          {headings.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} class={`toc-link ${indentClass(heading.depth)}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </>
)}

<script>
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>('.post h2, .post h3, .post h4'),
  );

  // 本文の見出しに「#」記号とアンカーリンクを付与
  headings.forEach((heading) => {
    if (!heading.id) {
      heading.id = (heading.textContent || '')
        .toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^\w-]+/g, '')
        .replace(/--+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
    }

    const headingContent = heading.innerHTML;
    const headingLevel = parseInt(heading.tagName.substring(1));
    heading.innerHTML = '';

    const wrapper = document.createElement('a');
    wrapper.href = `#${heading.id}`;
    wrapper.className = 'heading-link';
    heading.appendChild(wrapper);

    const container = document.createElement('div');
    container.className = 'flex items-center border-b border-gray-300 dark:border-gray-600 pb-1';
    wrapper.appendChild(container);

    const mdSymbol = document.createElement('span');
    mdSymbol.className = 'text-gray-500 dark:text-gray-400 mr-2 font-mono';
    mdSymbol.setAttribute('aria-hidden', 'true');
    mdSymbol.textContent = '#'.repeat(headingLevel);
    container.appendChild(mdSymbol);

    const textSpan = document.createElement('span');
    textSpan.innerHTML = headingContent;
    container.appendChild(textSpan);
  });

  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
  const popover = document.getElementById('toc-popover');

  // 現在読んでいる見出しを aria-current で示す（両方の目次に反映）
  const setActive = (id: string | null) => {
    tocLinks.forEach((link) => {
      if (id && link.getAttribute('href') === `#${id}`) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  if (headings.length > 0 && tocLinks.length > 0) {
    let ticking = false;
    const update = () => {
      ticking = false;
      // ヘッダー分を考慮し、画面上部付近を通過した最後の見出しを現在位置とする
      const threshold = 120;
      let current: HTMLElement | null = null;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top - threshold <= 0) {
          current = heading;
        } else {
          break;
        }
      }
      setActive((current ?? headings[0]).id);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  if (popover) {
    // 項目を選んだらポップオーバーを閉じる
    popover.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => popover.hidePopover());
    });

    // 開閉状態を支援技術に伝え、開いた時は現在位置の項目が見えるようにする
    const fab = document.querySelector<HTMLButtonElement>('.toc-fab');
    fab?.setAttribute('aria-expanded', 'false');
    popover.addEventListener('toggle', (event) => {
      const isOpen = (event as ToggleEvent).newState === 'open';
      fab?.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        popover.querySelector('[aria-current]')?.scrollIntoView({ block: 'nearest' });
      }
    });

    // PC幅に切り替わったら開いたままのポップオーバーを閉じる
    const desktop = window.matchMedia('(min-width: 80rem)');
    desktop.addEventListener('change', (e) => {
      if (e.matches && popover.matches(':popover-open')) popover.hidePopover();
    });
  }
</script>

<style is:global>
  .heading-link {
    color: inherit;
    text-decoration: none !important;
    display: inline-block;
    width: 100%;
  }

  .post :is(h2, h3, h4) {
    scroll-margin-top: 5rem;
  }

  /* 目次のあるページだけスムーススクロール（「動きを減らす」設定時は即時移動） */
  @media (prefers-reduced-motion: no-preference) {
    html:has(.toc-link) {
      scroll-behavior: smooth;
    }
  }

  .post :is(h2, h3, h4) a {
    text-decoration: none !important;
  }

  /* ---------- 目次リスト（PC / SP 共通） ---------- */
  .toc-link {
    display: block;
    /* global.css の `nav a { margin-right }` を打ち消す */
    margin: 0 0 0 -1px;
    padding-top: 0.375rem;
    padding-bottom: 0.375rem;
    padding-right: 0.5rem;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-neutral-600);
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--color-neutral-900);
    border-left-color: var(--color-neutral-400);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--color-blue-500);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .toc-link[aria-current] {
    color: var(--color-neutral-900);
    font-weight: 700;
    border-left-color: var(--color-blue-600);
  }

  .dark .toc-link {
    color: var(--color-neutral-300);
  }

  .dark .toc-link:hover,
  .dark .toc-link[aria-current] {
    color: var(--color-white);
  }

  .dark .toc-link:hover {
    border-left-color: var(--color-neutral-500);
  }

  .dark .toc-link[aria-current] {
    border-left-color: var(--color-blue-400);
  }

  /* ---------- SP: 右下のボタン ---------- */
  .toc-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: var(--z-header);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background-color: var(--color-neutral-800);
    color: var(--color-white);
    box-shadow:
      0 4px 12px rgb(0 0 0 / 0.2),
      0 1px 3px rgb(0 0 0 / 0.15);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background-color 0.15s ease;
  }

  .toc-fab:hover {
    background-color: var(--color-neutral-700);
  }

  .toc-fab:active {
    transform: scale(0.94);
  }

  .toc-fab:focus-visible {
    outline: 2px solid var(--color-blue-500);
    outline-offset: 3px;
  }

  .dark .toc-fab {
    background-color: var(--color-neutral-100);
    color: var(--color-neutral-900);
  }

  .dark .toc-fab:hover {
    background-color: var(--color-white);
  }

  .toc-fab-icon-close {
    display: none;
  }

  .toc-mobile:has(.toc-popover:popover-open) .toc-fab-icon-open {
    display: none;
  }

  .toc-mobile:has(.toc-popover:popover-open) .toc-fab-icon-close {
    display: block;
  }

  /* ---------- SP: ボタンの上に出るポップオーバー ---------- */
  .toc-popover {
    position: fixed;
    inset: auto;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(max(1rem, env(safe-area-inset-bottom)) + 3.75rem);
    width: min(20rem, calc(100vw - 2rem));
    max-height: min(60vh, 28rem);
    margin: 0;
    padding: 1rem 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    background-color: var(--color-white);
    color: inherit;
    box-shadow:
      0 12px 32px rgb(0 0 0 / 0.16),
      0 2px 6px rgb(0 0 0 / 0.08);

    opacity: 0;
    transform: translateY(0.5rem) scale(0.96);
    transform-origin: bottom right;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      overlay 0.2s ease allow-discrete,
      display 0.2s ease allow-discrete;
  }

  .toc-popover:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .toc-popover:popover-open {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.96);
    }
  }

  .dark .toc-popover {
    border-color: var(--color-neutral-700);
    background-color: var(--color-neutral-900);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-popover,
    .toc-fab,
    .toc-link {
      transition: none;
    }
    .toc-popover,
    .toc-popover:popover-open {
      transform: none;
    }
  }
</style>
